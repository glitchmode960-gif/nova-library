local UserInputService = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")
local GuiService = game:GetService("GuiService")
local CoreGui = game:GetService("CoreGui")
local LP = Players.LocalPlayer

-- ============================================================
-- ТЕМЫ
-- ============================================================
local THEMES = {
    Purple = { Accent = Color3.fromRGB(140, 90, 255), Light = Color3.fromRGB(200, 160, 255) },
    Blue   = { Accent = Color3.fromRGB(80, 120, 255), Light = Color3.fromRGB(140, 180, 255) },
    Red    = { Accent = Color3.fromRGB(240, 70, 90),  Light = Color3.fromRGB(255, 140, 150) },
    Green  = { Accent = Color3.fromRGB(60, 210, 130), Light = Color3.fromRGB(150, 245, 190) },
    Orange = { Accent = Color3.fromRGB(255, 150, 60), Light = Color3.fromRGB(255, 200, 140) },
    Pink   = { Accent = Color3.fromRGB(255, 100, 200), Light = Color3.fromRGB(255, 170, 230) },
