    Warning  = Color3.fromRGB(255, 180, 60),
}

-- ============================================================
-- УТИЛИТЫ
-- ============================================================
local function container()
    local ok, hui = pcall(function() return gethui and gethui() or CoreGui end)
    return ok and hui or CoreGui
end

local function create(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do obj[k] = v end
    if parent then obj.Parent = parent end
    return obj
end

local function corner(parent, r)
    return create("UICorner", { CornerRadius = UDim.new(0, r or 8) }, parent)
end

local function stroke(parent, color, thick, transp)
    return create("UIStroke", {
        Color = color or THEMES[currentTheme].Accent,
        Thickness = thick or 1.5,
        Transparency = transp or 0.2,
    }, parent)
end

local function padding(parent, t, r, b, l)
    return create("UIPadding", {
        PaddingTop = UDim.new(0, t or 0),
        PaddingRight = UDim.new(0, r or 0),
        PaddingBottom = UDim.new(0, b or 0),
        PaddingLeft = UDim.new(0, l or 0),
    }, parent)
end

local function list(parent, gap)
    return create("UIListLayout", {
        Padding = UDim.new(0, gap or 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, parent)
end

local function pointerPos(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        local inset = GuiService:GetGuiInset()
        return Vector2.new(input.Position.X + inset.X, input.Position.Y + inset.Y)
    end
    return UserInputService:GetMouseLocation()
end

local function playSound(kind)
    pcall(function()
        local id
        if kind == "success" then id = "rbxassetid://6895079853"
        elseif kind == "error" then id = "rbxassetid://6895079929"
        elseif kind == "warning" then id = "rbxassetid://6895079999"
        else id = "rbxassetid://6895080031" end
        local s = create("Sound", {
            SoundId = id, Volume = 0.3, Parent = SoundService,
        })
        s:Play()
        task.delay(2, function() s:Destroy() end)
    end)
end

-- ============================================================
-- NOTIFY
-- ============================================================
local notifyHolder
local notifyQueue = {}
local notifyActive = false

local function initNotify(parent)
    if notifyHolder and notifyHolder.Parent then return end
    notifyHolder = create("Frame", {
        Name = "Notifications",
        Size = UDim2.new(0, 320, 1, 0),
        Position = UDim2.new(1, -330, 0, 0),
        BackgroundTransparency = 1,
        ZIndex = 9999,
        Parent = parent,
    })
end

local function buildNotify(cfg)
    local kind = cfg.Kind or "info"
    local accent = THEMES[currentTheme].Accent
    local icon = "💬"
    if kind == "success" then accent = COLORS.Success; icon = "✓"
    elseif kind == "error" then accent = COLORS.Error; icon = "✕"
    elseif kind == "warning" then accent = COLORS.Warning; icon = "⚠" end

    local n = create("Frame", {
        Name = "Notify",
        Size = UDim2.new(1, 0, 0, 72),
        Position = UDim2.new(1, 350, 0, 0),
        BackgroundColor3 = COLORS.PANEL,
        BorderSizePixel = 0,
        ZIndex = 10000,
    }, notifyHolder)
    corner(n, 10)
    stroke(n, accent, 2, 0.15)

    local ic = create("Frame", {
        Size = UDim2.fromOffset(32, 32),
        Position = UDim2.fromOffset(10, 10),
        BackgroundColor3 = accent,
        BackgroundTransparency = 0.75,
        BorderSizePixel = 0,
        ZIndex = 10001,
    }, n)
    corner(ic, 999)

    create("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = icon, TextColor3 = accent, TextSize = 16,
        ZIndex = 10002, Parent = ic,
    })
    create("TextLabel", {
        Size = UDim2.new(1, -60, 0, 20),
        Position = UDim2.fromOffset(52, 8),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = cfg.Title or "Уведомление",
        TextColor3 = COLORS.Text, TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 10001, Parent = n,
    })
    create("TextLabel", {
        Size = UDim2.new(1, -60, 0, 40),
        Position = UDim2.fromOffset(52, 26),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = cfg.Content or "",
        TextColor3 = COLORS.Subtext, TextSize = 12,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = 10001, Parent = n,
    })

    local bar = create("Frame", {
        Position = UDim2.new(0, 10, 1, -6),
        Size = UDim2.new(1, -20, 0, 3),
        BackgroundColor3 = accent,
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        ZIndex = 10001,
    }, n)
    corner(bar, 999)

    return n, bar
end

local function reflow()
    local active = {}
    for _, c in ipairs(notifyHolder:GetChildren()) do
        if c:IsA("Frame") and c.Name == "Notify" then table.insert(active, c) end
    end
    for i, n in ipairs(active) do
        TweenService:Create(n, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 20, 0, 20 + (i - 1) * 80),
        }):Play()
    end
end

local function processQueue()
    if notifyActive or #notifyQueue == 0 then return end
    notifyActive = true
    local cfg = table.remove(notifyQueue, 1)
    local n, bar = buildNotify(cfg)
    reflow()

    local dur = cfg.Duration or 4
    TweenService:Create(bar, TweenInfo.new(dur, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0, 0, 0, 3),
    }):Play()

    if cfg.Sound ~= false then playSound(cfg.Kind or "info") end

    task.delay(dur, function()
        TweenService:Create(n, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 350, 0, n.Position.Y.Offset),
        }):Play()
        task.wait(0.35)
        n:Destroy()
        notifyActive = false
        reflow()
        processQueue()
    end)
end

function Nova:Notify(cfg)
    table.insert(notifyQueue, cfg or {})
    processQueue()
end

