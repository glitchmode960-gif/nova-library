--[[
    NOVA UI Library v1.0
    Своя библиотека с нуля. Фишки:
    • Glow-свечение вокруг окна (пульсирует)
    • Particles на фоне
    • Мини-бар при сворачивании
    • Drag за любое место
    • Notify с очередью и звуком
    • Click FX (Rings / Burst / Pulse / Focus)
    • Тени, glass-эффект, блики
    • Всё в одном файле

    Load:
        local Nova = loadstring(game:HttpGet("твоя_ссылка"))()
        local win = Nova:CreateWindow({ Title = "Hole Farm", Theme = "Purple" })
        local tab = win:CreateTab({ Name = "Main" })
        tab:CreateButton({ Name = "Click", Callback = function() print("hi") end })
]]

local Nova = {}
Nova.Version = "1.0"
Nova.Brand = "Nova"

local Players = game:GetService("Players")
