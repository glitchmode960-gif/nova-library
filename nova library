local COLORS = {
    BG       = Color3.fromRGB(18, 18, 24),
    PANEL    = Color3.fromRGB(26, 26, 34),
    ITEM     = Color3.fromRGB(34, 34, 44),
    HOVER    = Color3.fromRGB(46, 46, 58),
    Text     = Color3.fromRGB(240, 240, 245),
    Subtext  = Color3.fromRGB(150, 150, 165),
